# Copie este arquivo para `.env` (na raiz do projeto) para repassar as credenciais
# do TMDB ao docker compose. As duas são opcionais — a aplicação roda sem elas,
# apenas sem pôsteres, sinopse, elenco e trailer.
# Pegue uma chave gratuita em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
