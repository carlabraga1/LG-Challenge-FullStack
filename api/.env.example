# Copie este arquivo para `.env` ANTES de rodar `npx prisma migrate deploy`.
# É a DATABASE_URL abaixo que o Prisma lê; sem ela a migration falha com
# "Environment variable not found: DATABASE_URL".
#
# O caminho do SQLite é resolvido pelo Prisma em relação à pasta do schema
# (api/prisma), por isso "./dev.db" e não "./prisma/dev.db".
DATABASE_URL="file:./dev.db"
PORT=3000
HOST=0.0.0.0
DATASET_DIR="../data/ml-latest-small"

# Enriquecimento opcional via TMDB. Defina OU a chave v3 OU o bearer token v4
# (o bearer tem precedência). Sem nenhum dos dois a API continua funcionando: o
# endpoint de detalhes devolve tmdb=null e a interface mostra um placeholder no
# lugar do pôster. Pegue uma chave gratuita em:
#   https://www.themoviedb.org/settings/api
# TMDB_API_KEY=""
# TMDB_BEARER_TOKEN=""
